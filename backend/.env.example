# ---- Database (Neon, project "Ladakh Vacation", database ladakh_crm) ---------
# Neon console -> Connection details, database "ladakh_crm".
#
# BOTH are required: prisma/schema.prisma declares `directUrl`, and Prisma
# refuses to start if the variable is missing. Leaving DIRECT_URL unset makes
# `prisma migrate deploy` fail during the build.
#
# DATABASE_URL  POOLED connection (host contains "-pooler"), used by the app.
# DIRECT_URL    DIRECT connection (no "-pooler"), used by migrations only:
#               migrations cannot run through a connection pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/ladakh_crm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/ladakh_crm?sslmode=require"

# ---- App --------------------------------------------------------------------
PORT=3000
CORS_ORIGIN="*"

# ---- Auth (used from Phase 2 onward) ---------------------------------------
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- Seed owner account -----------------------------------------------------
SEED_ADMIN_EMAIL="admin@ladakhvacation.in"
SEED_ADMIN_PASSWORD=""   # leave empty: seed with a random value, then run `npm run set-login`
SEED_ADMIN_NAME="Ladakh Vacation Owner"

# ---- SEO module -------------------------------------------------------------
# Optional. Without it the PageSpeed API works but is throttled per-IP and
# audits with more than a couple of pages get 429s. Grab one free at
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=""

# ---- File Storage (Neon Object Storage, S3-compatible) ---------------------
# Required for durable file uploads (HR docs, voucher scans, website media).
# Without these, the app still runs but file uploads are disabled.
# Neon console -> project "Ladakh Vacation" -> Storage. The bucket must be set
# to public_read for the returned links to open, as on Glitz.
STORAGE_BUCKET="uploads"
AWS_ENDPOINT_URL_S3=""
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Email Marketing (Brevo / Sendinblue) -----------------------------------
# Optional. Required for broadcast email campaigns. Without this, email is in
# disabled mode and sends fail with a configuration error.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="ladakhvacation@gmail.com"
BREVO_SENDER_NAME="Ladakh Vacation"

# Origin of the CRM frontend, used to build links inside transactional email
# (currently the password-reset link). Must match where the CRM is actually
# deployed — a wrong value produces reset emails whose link goes nowhere.
CRM_BASE_URL="http://localhost:3001"

# ---- Integrations (AES-256-GCM encryption key for credentials at rest) --------
# 64 hex chars = 32 bytes. Required to store or read third-party credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_KEY="change-this-to-a-64-character-hex-string-for-aes-256-gcm"

# Public backend origin used for email unsubscribe URLs, without /api.
# Required for email campaigns; set to the actual HTTPS Render service URL.
APP_URL=""

# Optional dedicated document encryption key. If omitted, INTEGRATION_KEY is used.
# Keep the chosen key stable and backed up: changing it prevents old downloads.
STORAGE_ENCRYPTION_KEY=""

# Required only when accepting Meta lead webhooks. Unsigned requests are rejected.
META_VERIFY_TOKEN=""
META_APP_SECRET=""
