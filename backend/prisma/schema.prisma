// Ladakh Vacation CRM — Prisma schema
// Phase 1: User + Role.  Phase 3: Lead + Activity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Every Role is an internal staff account. External parties (hotels /
/// transport / B2B agents / prospective clients) are DATA — Vendor, Partner,
/// Lead — never logins. Do not add VENDOR, AGENT or GUEST back here; the
/// supplier-protection story falls apart the moment any outsider gets a
/// session token.
enum Role {
  SUPER_ADMIN
  OWNER
  SALES_MANAGER
  SALES_EXEC
  ACCOUNTS
  MARKETING
  OPERATIONS
}

enum InvoiceStatus {
  DRAFT
  PAID
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  CANCELLED
  LOST
  FUTURE_FOLLOWUP
}

// ============================================================================
// PHASE 18 — Itinerary builder
// ============================================================================
//
// A quotation shows the PRICE the client will pay. An itinerary shows the
// day-by-day PLAN — pickup at the airport, hotel for two nights, shikara
// ride, gondola in Gulmarg. They're two separate artefacts that get sent
// together. The itinerary lives on the Lead (same as quotations) so both
// can be produced before the lead is confirmed as a booking.

enum ItineraryItemKind {
  STAY // hotel / houseboat night
  TRANSFER // pickup, drop, inter-city drive
  SIGHTSEEING // gardens, monuments, viewpoints
  MEAL // breakfast, lunch, dinner
  ACTIVITY // shikara, skiing, trekking
  FREE_TIME
  NOTE
}

model Itinerary {
  id   String @id @default(cuid())
  /// Sequential per year — GLZ-ITI-2026-0001. Same convention as quotes and
  /// bookings; race-safe via withNumberRetry.
  code String @unique

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ItineraryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // --- client-facing cover ---
  title    String
  headline String?
  intro    String?
  totalPax Int     @default(2)

  // Optional inclusion / exclusion lists (free-form, one per line).
  inclusions String?
  exclusions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days    ItineraryDay[]
  options ItineraryOption[]
  socialPosts SocialPost[] @relation("SocialPostPackage")

  @@index([leadId])
}

/// Price tiers for the same day-by-day plan (e.g. Budget / Standard / Deluxe).
/// The days + items structure is shared; each option carries its own hotel /
/// transport picks via ItineraryItemPricing rows. Every itinerary always
/// has at least one option — the service auto-creates a "Package" on new
/// itineraries so simple single-price flows still work.
model ItineraryOption {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  name          String
  sortOrder     Int     @default(0)
  isRecommended Boolean @default(false)

  /// Option-level markup override. Null = fall back to service-type default.
  markupPercent Float?

  // --- computed, denormalised on every pricing write ---
  totalNet               Int   @default(0)
  totalSell              Int   @default(0)
  totalMargin            Int   @default(0)
  /// profit / sell * 100
  marginPercent          Float @default(0)
  /// profit / cost * 100
  markupPercentEffective Float @default(0)
  perPersonSell          Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricing ItineraryItemPricing[]

  @@index([itineraryId])
}

model ItineraryDay {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  /// 1-based, unique per itinerary. Reordering days re-numbers this — see
  /// ItinerariesService.reorderDays.
  dayNumber Int
  /// Optional — leave blank for a flexible plan.
  date      DateTime?
  city      String?
  headline  String?
  summary   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ItineraryItem[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

model ItineraryItem {
  id    String       @id @default(cuid())
  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  kind        ItineraryItemKind @default(SIGHTSEEING)
  /// Free-form time hint — "09:00", "Afternoon", "Evening" — kept as text
  /// because tour operators use both clock times and named parts of day.
  time        String?
  title       String
  description String?
  location    String?

  /// Optional vendor link — used to auto-fill title/description from a
  /// stored hotel or transport vendor. Distinct from per-option vendorRateId
  /// on ItineraryItemPricing: this one is the "structural" hotel choice, used
  /// for text; pricing rows carry the actual RATE the tier is priced at.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// Structural quantity + units — SHARED across price tiers because they
  /// describe the plan (2 rooms × 3 nights), not the money. Only the unit
  /// rate differs between Budget and Deluxe.
  quantity Int @default(1)
  units    Int @default(1)

  /// True when this item contributes to the option totals. Defaults per
  /// kind: STAY / TRANSFER / ACTIVITY / MEAL default true; SIGHTSEEING /
  /// FREE_TIME / NOTE default false. Operator can override.
  priceable Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricing ItineraryItemPricing[]

  @@index([dayId, sortOrder])
}

/// Per-item, per-option price cell. A row is written when an operator picks
/// a rate (or types a manual price) for a specific priceable item under a
/// specific tier. Absence = "not priced yet under this tier" (contributes 0
/// to the tier's totals but flagged in the UI).
model ItineraryItemPricing {
  id String @id @default(cuid())

  itemId String
  item   ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  optionId String
  option   ItineraryOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  /// Optional pointer to the stored VendorRate this came from. Convenient
  /// for auditing ("which rate contract was this priced under?") — the
  /// numbers are frozen either way.
  vendorRateId String?
  /// Optional vendor for display when the rate wasn't picked from stored
  /// rates (e.g. one-off transport quote).
  vendorId     String?

  /// REQUIRED. Net cost per unit per quantity (whole rupees).
  unitNet       Int
  /// Line-level markup override. Null = use option / global default.
  markupPercent Float?

  // --- computed ---
  lineNet  Int @default(0)
  lineSell Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, optionId])
  @@index([optionId])
}

// ============================================================================
// PHASE 11 — HR module
// ============================================================================
//
// The Employee is a person on payroll — separate from User (login account),
// because not every employee has CRM access and not every login is on payroll.
// Optional userId links the two when they overlap. Salary slips and interview
// records live off Employee so history is retained if the person leaves.

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE
  EXITED
}

enum InterviewOutcome {
  PENDING
  SELECTED
  ON_HOLD
  REJECTED
}

model Employee {
  id String @id @default(cuid())

  /// Human-friendly code, e.g. GLZ-EMP-0001. Sequential per year — same
  /// pattern as quoteNumber / bookingNumber so ops recognise it on sight.
  code String @unique

  // --- identity ---
  fullName    String
  fatherName  String?
  photoUrl    String?
  bloodGroup  String?
  dob         DateTime?
  gender      String?
  nationality String?   @default("Indian")

  // --- contact ---
  phone       String
  altPhone    String?
  email       String?
  addressLine String?
  city        String?
  state       String?
  pincode     String?

  // --- emergency ---
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // --- ID + tax ---
  aadhaar String?
  pan     String?

  // --- employment ---
  designation    String
  department     String?
  employmentType EmploymentType   @default(FULL_TIME)
  status         EmploymentStatus @default(ACTIVE)
  joinedOn       DateTime
  confirmedOn    DateTime?
  exitedOn       DateTime?
  reportsToId    String?
  reportsTo      Employee?        @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports        Employee[]       @relation("EmployeeReportsTo")

  /// Optional link to the login account. Set when the employee also has CRM
  /// access. Nullable because most HR records outlive their login (or never
  /// need one — e.g. driver, admin support).
  userId String? @unique
  user   User?   @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)

  // --- pay structure (monthly, in paise-consistent integer INR) ---
  ctcMonthly      Int?
  basicMonthly    Int?
  hraMonthly      Int?
  allowMonthly    Int?
  pfMonthly       Int?
  esiMonthly      Int?
  taxMonthly      Int?
  otherDedMonthly Int?
  bankName        String?
  accountNumber   String?
  ifsc            String?

  // --- free-form ---
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salarySlips SalarySlip[]
  interviews  Interview[]  @relation("InterviewInterviewer")

  @@index([status])
  @@index([department])
  @@index([reportsToId])
}

/// A salary slip is a FROZEN snapshot for a month. We store the components
/// even though they're on Employee today, because HR raises will change the
/// Employee row and slips from prior months must not shift.
model SalarySlip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The month this slip is for. First day of month at 00:00 UTC.
  periodMonth DateTime

  daysWorked  Int?
  daysInMonth Int?
  lop         Int? // loss of pay days

  // ---- earnings (all in whole rupees) ----
  basic      Int @default(0)
  hra        Int @default(0)
  allowances Int @default(0)
  bonus      Int @default(0)
  arrears    Int @default(0)

  // ---- deductions ----
  pf       Int @default(0)
  esi      Int @default(0)
  tax      Int @default(0)
  otherDed Int @default(0)

  // ---- computed and stored so historic slips never drift ----
  grossPay Int @default(0)
  totalDed Int @default(0)
  netPay   Int @default(0)

  paidOn    DateTime?
  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodMonth])
  @@index([periodMonth])
}

model Interview {
  id String @id @default(cuid())

  // --- candidate ---
  candidateName   String
  candidatePhone  String
  candidateEmail  String?
  role            String
  scheduledAt     DateTime
  durationMinutes Int?     @default(45)

  // --- interviewer (optional link to Employee) ---
  interviewerId   String?
  interviewer     Employee? @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  interviewerName String?

  // --- structured feedback ---
  /// Array of { question, answer, rating }. Kept as JSON so the sheet template
  /// can evolve without a schema migration on every tweak.
  questionnaire Json? @default("[]")

  overallRating Int? // 1..5
  strengths     String?
  concerns      String?
  outcome       InterviewOutcome @default(PENDING)
  outcomeNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
  @@index([scheduledAt])
}

// ============================================================================
// PHASE 12 — SEO
// ============================================================================

model SeoSite {
  id String @id @default(cuid())

  /// Human name — "Ladakh Vacation main site", "Kashmir landing pages".
  name String
  /// Homepage URL — the crawler starts here.
  url  String @unique

  /// Paths to include in every audit (relative or absolute). e.g. ["/",
  /// "/kashmir", "/ladakh"]. Empty array = just the homepage.
  crawlPaths String[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits SeoAudit[]
  offPageScores SeoOffPage[]
  domainSignals SeoDomainSignals?
  searchAnalytics SeoSearchAnalytics[]
  searchDimensions SeoSearchDimensionDaily[]

  @@index([isActive])
}

/// Google Search Console performance data at date x page x query grain.
///
/// The Ads search-terms report told us what to BUILD. This tells us whether it
/// worked: which of the 299 pages actually rank, for what, and how close to
/// page one. Positions 11-20 with real impressions are the cheapest wins on the
/// site, because the page already ranks and usually only needs a title rewrite
/// or an internal link.
///
/// Rows are immutable facts about a past day, so a re-sync of the same window
/// updates in place rather than appending. Search Console does restate recent
/// days, which is why the sync deliberately re-pulls a window it has seen.
model SeoSearchAnalytics {
  id     String  @id @default(cuid())
  siteId String
  site   SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Midnight UTC of the reported day. Search Console reports in Pacific Time;
  /// the date string is stored as given rather than shifted, so this is the
  /// day as Google labelled it.
  date  DateTime
  /// Full page URL exactly as Search Console reports it.
  page  String
  /// The search query. Empty string for an anonymised query, which Google
  /// withholds for rare terms; those rows still carry real impressions.
  query String

  clicks      Int   @default(0)
  impressions Int   @default(0)
  /// PERCENT, 0-100. The API returns a 0-1.0 fraction; storing that raw would
  /// make an 8% CTR read as 0.08 and score zero in calculatePageSignalPoints.
  ctr         Float @default(0)
  /// Average position. Lower is better.
  position    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Natural key. All four columns are NOT NULL, so unlike AdSpend's key this
  /// one actually dedupes: Postgres treats NULLs as distinct, and a nullable
  /// component would make every re-sync insert duplicates.
  @@unique([siteId, date, page, query], map: "SeoSearchAnalytics_natural_key")
  @@index([siteId, date])
  @@index([siteId, page])
  @@index([siteId, position])
}
/// Search Console totals by one dimension per day: the whole site, each page,
/// each device and each country.
///
/// Separate from SeoSearchAnalytics because Google omits anonymized queries from
/// any breakdown by query while still counting them in totals, so site and page
/// figures added up from query rows come out too low. These rows come from pulls
/// without the query dimension, and they are what the dashboard headlines use.
///
/// Totals are aggregated by property and page rows by page, so page rows are
/// not expected to add up to the site row.
model SeoSearchDimensionDaily {
  id     String  @id @default(cuid())
  siteId String
  site   SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  date      DateTime
  /// site | page | device | country
  dimension String
  /// '' for site; page URL; DESKTOP, MOBILE or TABLET; ISO 3166-1 alpha-3 code.
  key       String

  clicks      Int   @default(0)
  impressions Int   @default(0)
  /// PERCENT, 0-100.
  ctr         Float @default(0)
  position    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, date, dimension, key], map: "SeoSearchDimensionDaily_natural_key")
  @@index([siteId, dimension, date])
}


/// Site-wide off-page signals. One row per site.
///
/// SeoOffPage is keyed (siteId, url) and holds PER-PAGE metrics. Google
/// Business Profile completeness, review volume, citation consistency and
/// site-level referring domains belong to the DOMAIN, not to any single URL —
/// storing them per-page would mean copying identical values across all 270
/// pages and updating every one of them whenever a review lands.
///
/// These lift every page's score equally, which is what a stronger domain
/// actually does.
model SeoDomainSignals {
  id     String  @id @default(cuid())
  siteId String  @unique
  site   SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // --- Google Business Profile ---
  /// 0-100. Completeness of the listing: hours, categories, services, Q&A.
  gbpCompleteness  Int?
  /// Total reviews on the profile. Verify against the live GBP, never guess —
  /// this figure also feeds AggregateRating JSON-LD on the public site.
  gbpReviewCount   Int?
  /// 1.0 - 5.0.
  gbpAverageRating Float?
  /// Posts published in the trailing 30 days. Local prominence decays without
  /// activity, so this is a rate, not a total.
  gbpPostsLast30d  Int?

  // --- Citations / NAP ---
  /// Directory and local listings carrying the business NAP.
  citationsTotal         Int?
  /// Of those, how many match the GBP name/address/phone exactly. The RATIO
  /// is what matters: inconsistent citations actively confuse local ranking.
  citationsNapConsistent Int?

  // --- Brand mentions ---
  brandMentionsLinked   Int?
  /// Mentions with no link. This is the outreach queue, not a score input.
  brandMentionsUnlinked Int?

  // --- Site-level authority ---
  referringDomainsTotal Int?
  /// Referring domains judged spammy. Costs part of the domain bonus, but the
  /// contribution is floored at zero so recording spam never drops a page
  /// below its no-data score.
  toxicDomainCount      Int?

  /// When a human last checked these against the live sources. Stale numbers
  /// are worse than none; the dashboard flags anything older than 90 days.
  verifiedOn DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An audit is a single point-in-time crawl of one page. Multiple pages under
/// one SeoSite produce multiple audit rows sharing a runId so the UI can
/// group them into a single "audit run".
model SeoAudit {
  id String @id @default(cuid())

  siteId String
  site   SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Shared across every page audited in the same trigger.
  runId String
  /// The exact URL audited.
  url   String

  /// 0-100 composite. Weighted average of checks + PageSpeed scores.
  score Int @default(0)

  /// PageSpeed Insights scores (0-100). Nullable when the API was skipped
  /// or returned an error.
  perfScore Int?
  a11yScore Int?
  bpScore   Int?
  seoScore  Int?

  /// Core Web Vitals (LCP ms, CLS x1000, INP ms).
  lcpMs  Int?
  clsX1k Int?
  inpMs  Int?

  /// Full structured check list — pass/fail per rule. Stored as JSON so the
  /// rule set can evolve without schema churn.
  /// Shape: { passed: [...], failed: [...], warnings: [...] }
  checks Json?

  /// Actionable task list generated from failed checks. UI shows this as the
  /// "do today" queue.
  tasks Json?

  /// Non-empty when the crawl or PageSpeed call raised.
  errors String?

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([runId])
}

enum AdChannel {
  GOOGLE_ADS
  META_ADS
  INSTAGRAM
  YOUTUBE
  LINKEDIN
  SEO
  EMAIL
  AFFILIATE
  OTHER
}

enum LeadSource {
  GOOGLE_ADS
  META_ADS
  INSTAGRAM
  FACEBOOK
  LANDING_PAGE
  WEBSITE
  ORGANIC
  REFERRAL
  WALK_IN
  PHONE
  WHATSAPP
  TRADE_FAIR
  EMAIL
  B2B_AGENT
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  STATUS_CHANGE
  ASSIGNMENT
  RE_ENQUIRY
  SYSTEM
}

model User {
  b2bPartners        B2bPartner[]          @relation("B2bOwner")
  createdInvoices    Invoice[]             @relation("CreatedInvoices")
  createdCampaigns   Campaign[]            @relation("CreatedCampaigns")
  createdSocialPosts  SocialPost[]          @relation("CreatedSocialPosts")
  attachments        Attachment[]          @relation("UploadedAttachments")
  mediaAssets        MediaAsset[]          @relation("UploadedMediaAssets")
  requestedApprovals LeadApprovalRequest[] @relation("RequestedApprovals")
  reviewedApprovals  LeadApprovalRequest[] @relation("ReviewedApprovals")
  id                 String                @id @default(cuid())
  email              String                @unique
  passwordHash       String
  name               String
  role               Role                  @default(SALES_EXEC)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  assignedLeads      Lead[]           @relation("LeadAssignee")
  createdBookings    Booking[]        @relation("BookingCreator")
  createdItineraries Itinerary[]      @relation("ItineraryCreator")
  recordedPayments   BookingPayment[] @relation("PaymentRecorder")
  activities         Activity[]

  /// Set when this login corresponds to a person on payroll.
  employee Employee? @relation("EmployeeUser")

  @@index([role])
}

model Lead {
  id String @id @default(cuid())

  // --- who ---
  name    String
  phone   String
  email   String?
  address String?
  state   String?
  city    String?
  country String?

  // --- what they want ---
  destination String?
  travelDate  DateTime?
  nights      Int?
  adults      Int?
  children    Int?
  budget      Int?
  message     String?

  // --- pipeline ---
  status     LeadStatus @default(NEW)
  source     LeadSource @default(OTHER)
  score      Int        @default(0)
  scoreNotes String?
  lostReason String?

  b2bPartnerId String?
  b2bPartner   B2bPartner? @relation(fields: [b2bPartnerId], references: [id])

  invoices             Invoice[]
  leadApprovalRequests LeadApprovalRequest[]

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // --- attribution (this is what makes ROAS possible later) ---
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  landingPage String?
  referrer    String?
  keyword     String?

  // --- context ---
  device    String?
  userAgent String?
  ipAddress String?

  enquiryCount   Int       @default(1)
  lastContact    DateTime?
  firstContactAt DateTime?
  nextFollowUp   DateTime?
  /// True when a human explicitly picked the nextFollowUp date. The
  /// auto-cadence scheduler will NOT overwrite manual dates — the exec's
  /// judgement wins. Cleared when the lead advances to a new stage that
  /// has its own SLA (a resumed cadence is intentional).
  followUpManual Boolean   @default(false)
  /// Stamped when the auto-cadence check finds a lead past its
  /// nextFollowUp. Cleared the moment a contact activity is logged.
  /// Used to surface "SLA breached" in the UI + dashboard tile.
  slaBreachAt    DateTime?

  /// Optional link to the Visit that produced this lead. Set only when the
  /// landing page beacon has fired and the form carried the returned visitId.
  /// Kept nullable because manual adds and re-enquiries do not have a visit.
  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  // --- import / external system linkage ---
  /// Free-form tags. Used first for 'unassigned' (owner lookup failed on
  /// import), 'imported' (came from a bulk source), plus future segmentation.
  tags           String[]  @default([])
  /// e.g. 'brevo_import_2026_08_21'. Null for organic captures. Groups leads
  /// by which import batch brought them in.
  externalSource String?
  /// Original ID in the source system (Brevo contact_id, etc). Unique per
  /// externalSource so re-runs are idempotent — same row won't insert twice.
  externalId     String?
  /// Whole original CSV row as JSON. Preserves 200+ Brevo fields we don't
  /// model individually. Never queried in the hot path — cold-storage safety
  /// net so nothing is lost.
  externalRaw    Json?
  importedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities  Activity[]
  bookings    Booking[]
  itineraries Itinerary[]
  campaignRecipients CampaignRecipient[]

  @@unique([externalSource, externalId], map: "Lead_external_natural_key")
  @@index([status])
  @@index([source])
  @@index([phone])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([visitId])
  @@index([externalSource])
}

// ============================================================================
// PHASE 10 — Attribution: landing pages, visits, ad spend
// ============================================================================
//
// The point of this module is one number: cost per lead by campaign, by page,
// by day. Storing a single daily total across all channels — the tempting
// shortcut — makes it impossible to tell which ad is losing you money, which
// is the reason to measure spend in the first place.
//
// The chain is:  AdSpend(channel, campaign, page, day)
//                     -> Visit(landingPage, utms, gclid/fbclid)
//                     -> Lead(visitId)
//                     -> Quote -> Booking (revenue).
// Everything above Lead is data you own; nothing here calls Google or Meta.
// Offline conversion upload back to Google Ads is a later job that reads
// Lead.gclid and Booking.totalSell.

model LandingPage {
  id   String  @id @default(cuid())
  /// URL slug, e.g. "kashmir-honeymoon-2026". Not the full URL — the page can
  /// live under multiple hostnames (staging, prod, apex, www) and still be
  /// the same funnel.
  slug String  @unique
  name String
  /// Optional canonical URL for display on the dashboard.
  url  String?

  /// Free-form label — "honeymoon", "family", "adventure". Used to roll the
  /// dashboard up by intent rather than exact page.
  campaign String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
  spend  AdSpend[]

  @@index([isActive])
}

model Visit {
  id String @id @default(cuid())

  /// The visitor's first-party cookie (set by the landing page snippet).
  /// A returning visitor keeps the same visitorId but produces a new Visit
  /// row per session so time-to-lead stays measurable.
  visitorId String
  /// One row per SESSION per PAGE. If the same visitor lands on the same
  /// page again more than 30 minutes later, that is a new visit.
  sessionId String

  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  /// Path or slug the beacon reported. Kept even when landingPageId is null
  /// so unregistered pages still show up in the dashboard.
  pagePath      String

  // --- attribution copied straight off the URL ---
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  referrer    String?
  keyword     String?

  // --- context ---
  device    String?
  userAgent String?
  ipAddress String?
  country   String?

  createdAt DateTime @default(now())

  leads Lead[]

  @@index([visitorId])
  @@index([sessionId])
  @@index([landingPageId, createdAt])
  @@index([createdAt])
}

/// Daily spend broken down as far as the source data allows. One row per
/// (date, channel, campaign, page) — DO NOT collapse to one row per day.
/// Without the split, cost-per-lead is a company-wide average and cannot
/// answer "which ad should I kill".
model AdSpend {
  id String @id @default(cuid())

  /// Midnight UTC of the spend day. Aggregations key on this.
  spendDate DateTime
  channel   AdChannel @default(GOOGLE_ADS)

  /// The ad-platform's campaign name/id, exactly as reported.
  campaign String?
  /// Optional ad-group / ad-set breakdown.
  adGroup  String?

  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  /// Amount in whole INR rupees (₹) to match the rest of the schema.
  /// 12500 = ₹12,500.
  amount   Int
  currency String @default("INR")

  /// Optional volumetric detail from the ad platform for CPC/CTR later.
  impressions Int?
  clicks      Int?

  notes String?

  // --- platform sync linkage -------------------------------------------------
  /// Which integration owns this row: 'google_ads', or null for a manual entry.
  /// Sync only ever touches rows carrying its own source, so a number an
  /// operator typed by hand is never overwritten by a later pull.
  externalSource String?
  /// The platform's natural key for the row — for Google Ads,
  /// `customerId:campaignId:YYYY-MM-DD`.
  ///
  /// AdSpend_natural_key cannot serve this purpose: it spans nullable columns
  /// and Postgres treats NULLs as distinct in a unique index, so an upsert
  /// against it inserts a duplicate every run instead of updating. Google
  /// restates the last few days of cost, so a sync MUST be re-runnable.
  externalId     String?
  /// When this row was last written by a platform sync.
  syncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spendDate, channel, campaign, landingPageId], map: "AdSpend_natural_key")
  @@unique([externalSource, externalId], map: "AdSpend_external_natural_key")
  @@index([spendDate])
  @@index([channel])
  @@index([landingPageId])
  @@index([externalSource])
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType @default(NOTE)
  content String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 4 — Vendors
// ============================================================================

enum VendorType {
  HOTEL
  HOUSEBOAT
  /// Seasonal tented camps (Nubra, Pangong, Sarchu, Tso Moriri, Hanle).
  CAMP
  TRANSPORT
  GUIDE
  ACTIVITY
  RESTAURANT
  PHOTOGRAPHER
  EVENT
  OTHER
}

enum Season {
  PEAK
  SHOULDER
  OFF
  FESTIVE
}

enum MealPlan {
  EP
  CP
  MAP
  AP
}

enum RateBasis {
  PER_ROOM_NIGHT
  PER_PERSON
  PER_PERSON_NIGHT
  PER_VEHICLE_DAY
  PER_TRANSFER
  PER_UNIT
}

model Vendor {
  id   String     @id @default(cuid())
  name String
  type VendorType @default(HOTEL)

  // where
  city    String?
  area    String?
  address String?

  // internal grading — your own quality call, not the star rating
  starRating  Int?
  falconGrade String?

  // --- SENSITIVE: redacted for sales execs (supplier protection) ---
  contactPerson String?
  phone         String?
  altPhone      String?
  email         String?
  bankName      String?
  accountNumber String?
  ifsc          String?

  // commercial
  gstin        String?
  panNumber    String?
  paymentTerms String?

  // transport only — local taxi-union zone constraints
  unionZone String?

  // --- hotel / property specifics -----------------------------------------
  // All optional. Filled in for HOTEL/HOUSEBOAT/CAMP; ignored for TRANSPORT etc.
  /// "14:00" — kept as a HH:MM string so timezone confusion can't creep in.
  checkInTime  String?
  /// "11:00" — checkout is the number ops needs on the client voucher.
  checkOutTime String?
  /// Total rooms in inventory. Not a live count — used to size availability
  /// gut-check, not for booking allocation.
  roomCount    Int?
  /// Free-form tags. Deliberately not an enum — hotel amenity lingo shifts
  /// too fast (spa, e-vehicle charging, halal kitchen, etc.).
  amenities    String[] @default([])

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates          VendorRate[]
  itineraryItems ItineraryItem[]

  @@index([type])
  @@index([city])
  @@index([isActive])
}

model VendorRate {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Room category for hotels ("Deluxe"), vehicle type for transport ("Innova").
  variant   String
  season    Season    @default(PEAK)
  mealPlan  MealPlan?
  rateBasis RateBasis @default(PER_ROOM_NIGHT)

  /// REQUIRED. What you actually pay the supplier.
  netRate  Int
  /// Optional. Published/rack rate for showing discount.
  rackRate Int?

  extraBedRate Int?
  childRate    Int?
  maxOccupancy Int?

  validFrom DateTime?
  validTo   DateTime?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The natural key of a rate line in a contract. Stops the same rate being
  /// entered twice with different prices, where whichever sorted first would
  /// silently win the quote.
  /// CAVEAT: Postgres treats NULLs as distinct in a unique index, so this only
  /// bites once mealPlan / rateBasis / validFrom are actually filled in.
  /// Always set validFrom — a rate contract without a start date is a guess.
  @@unique([vendorId, variant, season, mealPlan, rateBasis, validFrom], map: "VendorRate_natural_key")
  @@index([vendorId])
  @@index([season])
  @@index([isActive])
  @@index([validFrom, validTo])
}

// ============================================================================
// PHASE 5 — Pricing + Quotations
// ============================================================================

enum ServiceType {
  HOTEL
  TRANSPORT
  ACTIVITY
  FLIGHT
  GUIDE
  MEAL
  PERMIT
  MISC
}

enum MarkupMode {
  /// Use the option / service-type / global default (the normal case).
  INHERIT
  /// Percentage on this line's net cost.
  PERCENT
  /// Flat amount added on top of this line's net cost.
  FIXED
  /// Operator types the sell price directly; margin is derived.
  MANUAL
}

/// Singleton config row (id is always "default").
model PricingSettings {
  id String @id @default("default")

  /// Fallback markup % when nothing more specific is set.
  defaultMarkupPercent Float @default(20)

  /// Per-service-type overrides. Null = fall back to defaultMarkupPercent.
  hotelMarkupPercent     Float?
  transportMarkupPercent Float?
  activityMarkupPercent  Float?
  flightMarkupPercent    Float?
  guideMarkupPercent     Float?
  mealMarkupPercent      Float?
  permitMarkupPercent    Float?
  miscMarkupPercent      Float?

  /// Policy: minimum acceptable MARGIN % (profit / sell price).
  minMarginPercent Float @default(15)

  /// Break-even inputs. Without these the advisory can only check margin %.
  monthlyOverhead Int?
  filesPerMonth   Int?

  gstPercent Float @default(5)
  /// Round sell prices to the nearest N rupees (0 = no rounding).
  roundTo    Int   @default(10)

  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PHASE 6 — Bookings + Payments
// ============================================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  PARTIALLY_PAID
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  RAZORPAY
  OTHER
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  status        BookingStatus @default(PENDING)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Where it came from. Frozen snapshot — the totals below do NOT follow
  /// later edits to the itinerary tier. Nullable so a manual lead-only
  /// booking (no plan behind it) can still exist.
  itineraryId       String?
  itineraryOptionId String?

  createdById String?
  createdBy   User?   @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // --- trip ---
  packageName     String?
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(2)
  children        Int       @default(0)
  nights          Int       @default(0)

  // --- FROZEN pricing snapshot (taken at confirmation) ---
  totalSell Int @default(0)
  /// Estimated cost from the quote at the time of booking.
  totalNet  Int @default(0)

  // --- running actuals ---
  totalReceived Int @default(0)
  totalCostPaid Int @default(0)

  notes           String?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments BookingPayment[]
  costs    BookingCost[]

  @@index([leadId])
  @@index([status])
  @@index([travelStartDate])
}

/// Money IN from the client. Negative amounts represent refunds.
model BookingPayment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount     Int
  mode       PaymentMode @default(BANK_TRANSFER)
  reference  String?
  receivedAt DateTime    @default(now())
  notes      String?
  isRefund   Boolean     @default(false)

  recordedById String?
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([receivedAt])
}

/// Money OUT to vendors — what is owed vs what has actually been paid.
model BookingCost {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  vendorId    String?
  description String

  amountDue  Int
  amountPaid Int       @default(0)
  paidAt     DateTime?
  reference  String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([vendorId])
}

// ============================================================================
// PHASE 27 — Integrations
// ============================================================================

enum IntegrationCategory {
  PAYMENT_DOMESTIC
  PAYMENT_INTERNATIONAL
  AI
  ADS
  SOCIAL
  /// Search Console, and later GA4. Separate from ADS because nothing here
  /// spends money; filed under ADS it was listed as an "Ads platform".
  ANALYTICS
}

enum IntegrationTestStatus {
  UNTESTED
  OK
  FAILED
}

/**
 * Third-party service credential. One row per configured provider — you can
 * have multiple rows of the same provider (e.g. two Razorpay accounts) which
 * is why `provider` is not @unique.
 * `credentials` is an AES-256-GCM blob of a JSON `{key: value}` map whose
 * shape is defined by the provider registry. `priority` is used by the AI
 * failover helper: higher = tried first.
 */
model Integration {
  id String @id @default(cuid())

  category IntegrationCategory
  provider String // e.g. "razorpay", "openai" — from providers.ts registry
  label    String? // user-friendly name, e.g. "Razorpay (main)"

  /// AES-256-GCM ciphertext of the JSON credentials. Never returned to the
  /// frontend in plaintext; only test/probe endpoints decrypt inside the
  /// service.
  credentials String

  isActive Boolean @default(true)
  /// Higher = tried first when the failover helper picks an integration.
  priority Int     @default(0)

  lastTestedAt    DateTime?
  lastTestStatus  IntegrationTestStatus @default(UNTESTED)
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive, priority])
  @@index([provider])
}

model B2bPartner {
  id             String  @id @default(uuid())
  agencyName     String
  contactName    String
  phone          String  @unique
  email          String?
  city           String?
  state          String?
  address        String?
  commissionRate Float   @default(10.0)

  assignedToId String
  assignedTo   User   @relation("B2bOwner", fields: [assignedToId], references: [id])

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique
  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id])

  subtotal  Float
  gstRate   Float @default(18.0)
  gstAmount Float
  total     Float

  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime?
  notes   String?

  createdById String
  createdBy   User   @relation("CreatedInvoices", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float
}

model LeadApprovalRequest {
  id            String         @id @default(uuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status        ApprovalStatus @default(PENDING)
  reason        String?
  requestedById String
  requestedBy   User           @relation("RequestedApprovals", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?          @relation("ReviewedApprovals", fields: [reviewedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


// ============================================================================
// FILE STORAGE � generic attachment linked to any entity
// ============================================================================

model Attachment {
  id           String   @id @default(uuid())
  url          String
  filename     String
  mimeType     String
  sizeBytes    Int
  folder       String   @default("general")

  /// Polymorphic link � "lead", "employee", "booking", "itinerary", etc.
  entityType   String?
  entityId     String?

  uploadedById String
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([uploadedById])
}

// ============================================================================
// PHASE 33 � MARKETING & BROADCAST ENGINE
// ============================================================================

enum CampaignChannel {
  WHATSAPP
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
  UNSUBSCRIBED
}

model Campaign {
  id             String          @id @default(uuid())
  name           String
  channel        CampaignChannel
  status         CampaignStatus  @default(DRAFT)

  // Audience filter definition stored as JSON
  audienceFilter Json            @default("{}")
  targetCount    Int             @default(0)

  // WhatsApp template details
  templateName   String?
  templateLang   String?         @default("en")
  templateParams Json?

  // Email fields
  emailSubject   String?
  emailHtml      String?

  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  totalSent      Int             @default(0)
  totalDelivered Int             @default(0)
  totalRead      Int             @default(0)
  totalFailed    Int             @default(0)
  estimatedCost  Float           @default(0.0)

  createdById    String
  createdBy      User            @relation("CreatedCampaigns", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  recipients     CampaignRecipient[]

  @@index([status])
  @@index([channel])
  @@index([createdById])
}

model CampaignRecipient {
  id               String                  @id @default(uuid())
  campaignId       String
  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId           String?
  lead             Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  phone            String?
  email            String?
  name             String?

  status           CampaignRecipientStatus @default(PENDING)
  externalId       String?
  errorMessage     String?

  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  unsubscribedAt   DateTime?
  unsubscribeToken String                  @unique @default(uuid())

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([campaignId, status])
  @@index([leadId])
  @@index([unsubscribeToken])
}

// ============================================================================
// LEAD ROUTING & AUTO-ASSIGNMENT SETTINGS
// ============================================================================

enum RoutingStrategy {
  ROUND_ROBIN
  PERFORMANCE_WEIGHTED
  LOAD_BALANCED
  MANUAL
}

model LeadRoutingSettings {
  id                 String          @id @default("default")
  isEnabled          Boolean         @default(true)
  strategy           RoutingStrategy @default(ROUND_ROBIN)
  highScoreThreshold Int             @default(60)
  lastAssignedUserId String?
  excludedUserIds    String[]        @default([])
  updatedAt          DateTime        @updatedAt
}

// ============================================================================
// PHASE 34 � SOCIAL MEDIA STUDIO & AI CONTENT ENGINE
// ============================================================================

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  PINTEREST
  LINKEDIN
  X
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ContentTone {
  STORYTELLING
  PROMOTIONAL
  PUNCHY_REEL
  INFORMATIVE
}

model SocialAccount {
  id           String         @id @default(uuid())
  platform     SocialPlatform
  accountName  String         // e.g. "Ladakh Vacation Official"
  handle       String         // e.g. "@ladakhvacation"
  externalId   String         // Page ID or IG Business ID
  accessToken  String         // Encrypted AES-256-GCM
  expiresAt    DateTime?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  posts        SocialPost[]

  @@unique([platform, externalId])
}

model SocialPost {
  id             String           @id @default(uuid())
  platform       SocialPlatform
  caption        String           @db.Text
  mediaUrls      String[]         @default([])
  status         SocialPostStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalPostId String?
  errorMessage   String?

  /// Metrics JSON: { likes: 0, comments: 0, shares: 0, reach: 0, impressions: 0 }
  metrics        Json?            @default("{}")

  accountId      String?
  account        SocialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  packageId      String?
  package        Itinerary?       @relation("SocialPostPackage", fields: [packageId], references: [id], onDelete: SetNull)

  createdById    String
  createdBy      User             @relation("CreatedSocialPosts", fields: [createdById], references: [id])

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([platform, status])
  @@index([scheduledAt])
}

model ContentIdea {
  id                String      @id @default(uuid())
  destination       String      // e.g. "Kashmir", "Ladakh", "Gulmarg"
  topic             String      // e.g. "Autumn Chinar Leaves at Nishat Bagh"
  tone              ContentTone @default(STORYTELLING)
  promptSeed        String?
  generatedVariants Json        // Array of { title, caption, hashtags, tone }
  hashtags          String[]    @default([])
  status            String      @default("IDEA") // IDEA | DRAFTED | PUBLISHED

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model SeoOffPage {
  id               String   @id @default(cuid())
  siteId           String
  site             SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url              String
  backlinkCount    Int      @default(0)
  referringDomains Int      @default(0)
  pageAuthority    Int?     // 0-100
  prMentions       Int      @default(0)
  socialShares     Int      @default(0)
  searchConsoleCtr Float?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([siteId, url])
  @@index([siteId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String   @default("")
  caption      String?
  tags         String[] @default([])
  pageSlug     String?
  folder       String   @default("website")
  uploadedById String
  uploadedBy   User     @relation("UploadedMediaAssets", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pageSlug])
  @@index([uploadedById])
}
