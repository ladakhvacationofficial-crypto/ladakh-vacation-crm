# Public API endpoint. Set in the Vercel web project before building.
NEXT_PUBLIC_LEAD_CAPTURE_URL=http://localhost:3000/api/leads/capture
# Optional. Use off to disable the wake ping.
NEXT_PUBLIC_WAKE_PING_URL=off

# CRM API in this same combined Vercel project
NEXT_PUBLIC_API_URL=http://localhost:3000/api
